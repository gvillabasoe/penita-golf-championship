{
  "name": "penita-golf-championship",
  "version": "1.2.0",
  "private": true,
  "description": "I Peñita Golf Championship - Ulzama-Bariain 2026",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "TSX_TSCONFIG_PATH=tsconfig.test.json node --import tsx --test \"src/**/__tests__/*.test.ts\" \"src/**/__tests__/*.test.tsx\" \"scripts/__tests__/*.test.ts\"",
    "test:watch": "TSX_TSCONFIG_PATH=tsconfig.test.json node --import tsx --test --watch \"src/**/__tests__/*.test.ts\" \"src/**/__tests__/*.test.tsx\" \"scripts/__tests__/*.test.ts\"",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:constraints": "psql \"$DIRECT_URL\" -f prisma/sql/constraints.sql",
    "db:studio": "prisma studio",
    "db:seed": "node --import tsx prisma/seed.ts",
    "gen:divergence": "node --import tsx scripts/generate-divergence-table.ts",
    "gen:icons": "node --import tsx scripts/generate-icons.ts",
    "check:refs": "bash scripts/check-references.sh",
    "verify": "npm run check:refs && npm run typecheck && npm test",
    "gen:sql": "node --import tsx scripts/generate-sql.ts",
    "db:schema": "psql \"$DIRECT_URL\" -f prisma/sql/schema.sql",
    "gen:seed-sql": "node --import tsx scripts/generate-seed-sql.ts"
  },
  "prisma": {
    "seed": "node --import tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.8",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "pdfjs-dist": "^5.6.0"
  },
  "optionalDependencies": {
    "@node-rs/argon2": "^1.8.3",
    "sharp": "^0.34.0"
  }
}
